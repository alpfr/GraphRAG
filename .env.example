# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=StrongAdminPassw0rd!

# Ollama Models
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ibm/granite4:latest
OLLAMA_EMBEDDING_MODEL=granite-embedding:278m

# LLM Provider Configuration (ollama, openai, anthropic, gemini)
# This sets the default provider — can be changed dynamically from the UI sidebar
LLM_PROVIDER=ollama

# LLM Parameters (optional — applied to all providers, overridable from UI)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TOP_P=1.0

# API Keys (required for cloud providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Per-provider model overrides (optional — defaults are used if not set)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-2.0-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
